# Copy to .env and fill in real values. Never commit real values.

# Lead form endpoint (Plan Your Trip). The form POSTs JSON to this URL.
# Until this is set, the form shows an honest "not yet available" state and
# a direct email fallback — it never pretends a submission succeeded.
# LAUNCH BLOCKER: must be set and tested before go-live.
PUBLIC_LEAD_ENDPOINT=

# Google Tag Manager container ID (e.g. GTM-XXXXXXX).
# When empty, no analytics script and no measurement cookies load at all.
# When set, GTM loads only after the visitor gives consent (see src/lib/).
PUBLIC_GTM_ID=

# Optional spam-protection site key (e.g. Cloudflare Turnstile) for the
# lead form. Wire-up is documented in docs/tracking-spec.md. Leave empty
# to rely on honeypot + time-based checks only.
PUBLIC_SPAM_PROTECTION_SITE_KEY=

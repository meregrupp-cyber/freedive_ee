---
const nav = [
  { label: 'Estonia', href: '/' },
  { label: 'Rummu', href: '/rummu-quarry/' },
  { label: 'Seasons', href: '/seasons-and-conditions/' },
  { label: 'Plan Your Trip', href: '/plan-your-trip/' },
];

const current = Astro.url.pathname;
---

<header class="site-header">
  <div class="wrap site-header__inner">
    <a class="wordmark" href="/" aria-label="Freedive Estonia — home">
      <svg width="26" height="26" viewBox="0 0 26 26" aria-hidden="true" focusable="false">
        <rect width="26" height="26" rx="6" fill="#0d3c43"></rect>
        <path d="M3 10.5h20" stroke="#e8f2f0" stroke-width="1.4" stroke-linecap="round"></path>
        <path d="M6 16c2.4-2 4.8-2 7.2 0s4.8 2 7.2 0" stroke="#82d8d1" stroke-width="1.6" fill="none" stroke-linecap="round"></path>
      </svg>
      <span>freedive<span class="wordmark__tld">.ee</span></span>
    </a>

    <button
      class="menu-toggle btn"
      type="button"
      aria-expanded="false"
      aria-controls="site-nav"
      id="menu-toggle"
    >
      <span class="menu-toggle__label">Menu</span>
    </button>

    <nav class="site-nav" id="site-nav" aria-label="Main">
      <ul>
        {
          nav.map((item) => (
            <li>
              <a href={item.href} aria-current={current === item.href ? 'page' : undefined}>
                {item.label}
              </a>
            </li>
          ))
        }
        <li class="site-nav__cta">
          <a
            class="btn btn--primary"
            href="/start-here/"
            data-track-event="select_route"
            data-track-route="start_here"
            data-track-origin="header"
            data-track-destination="/start-here/"
          >
            Start here
          </a>
        </li>
      </ul>
    </nav>
  </div>
</header>

<script>
  const toggle = document.getElementById('menu-toggle');
  const nav = document.getElementById('site-nav');

  if (toggle && nav) {
    const close = () => {
      nav.classList.remove('is-open');
      toggle.setAttribute('aria-expanded', 'false');
    };
    toggle.addEventListener('click', () => {
      const open = nav.classList.toggle('is-open');
      toggle.setAttribute('aria-expanded', String(open));
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && nav.classList.contains('is-open')) {
        close();
        toggle.focus();
      }
    });
    document.addEventListener('click', (e) => {
      if (
        nav.classList.contains('is-open') &&
        e.target instanceof Node &&
        !nav.contains(e.target) &&
        !toggle.contains(e.target)
      ) {
        close();
      }
    });
    nav.querySelectorAll('a').forEach((a) => a.addEventListener('click', close));
  }
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: rgba(4, 21, 29, 0.92);
    border-bottom: 1px solid var(--line);
    backdrop-filter: blur(8px);
  }

  .site-header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2);
    min-height: 4rem;
  }

  .wordmark {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    font-weight: 800;
    font-size: 1.15rem;
    letter-spacing: 0.02em;
    color: var(--foam-50);
    text-decoration: none;
    white-space: nowrap;
  }

  .wordmark__tld {
    color: var(--aqua-300);
  }

  .site-nav ul {
    list-style: none;
    display: flex;
    align-items: center;
    gap: clamp(0.8rem, 2vw, 1.6rem);
    margin: 0;
    padding: 0;
  }

  .site-nav a:not(.btn) {
    color: var(--mist-100);
    text-decoration: none;
    font-weight: 550;
    padding: 0.6rem 0.2rem;
    display: inline-block;
  }

  .site-nav a:not(.btn):hover,
  .site-nav a[aria-current='page'] {
    color: var(--aqua-300);
  }

  .site-nav a[aria-current='page'] {
    border-bottom: 2px solid var(--aqua-300);
  }

  .menu-toggle {
    display: none;
  }

  @media (max-width: 47rem) {
    .menu-toggle {
      display: inline-flex;
      padding: 0.55rem 1rem;
    }

    .site-nav {
      display: none;
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      background: var(--ink-900);
      border-bottom: 1px solid var(--line);
      padding: var(--space-2) clamp(1.1rem, 4vw, 2.5rem) var(--space-3);
    }

    .site-nav.is-open {
      display: block;
    }

    .site-nav ul {
      flex-direction: column;
      align-items: stretch;
      gap: 0.3rem;
    }

    .site-nav a:not(.btn) {
      display: block;
      padding: 0.8rem 0.2rem;
      font-size: var(--step-1);
    }

    .site-nav__cta {
      margin-top: var(--space-1);
    }

    .site-nav__cta .btn {
      width: 100%;
      justify-content: center;
    }
  }
</style>

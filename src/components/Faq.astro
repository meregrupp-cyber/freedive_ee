---
interface Props {
  items: { q: string; a: string }[];
  heading?: string;
}

const { items, heading = 'Questions before you decide' } = Astro.props;

/**
 * FAQPage schema is built from the same array that renders below, so the
 * structured data can never describe anything the visitor cannot see.
 */
const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: items.map((item) => ({
    '@type': 'Question',
    name: item.q,
    acceptedAnswer: { '@type': 'Answer', text: item.a },
  })),
};
---

<script is:inline type="application/ld+json" set:html={JSON.stringify(faqLd)} />

<section class="section section--line" aria-labelledby="faq-heading">
  <div class="wrap">
    <h2 id="faq-heading">{heading}</h2>
    <div class="faq">
      {
        items.map((item) => (
          <>
            <h3>{item.q}</h3>
            <p set:html={item.a} />
          </>
        ))
      }
    </div>
  </div>
</section>
